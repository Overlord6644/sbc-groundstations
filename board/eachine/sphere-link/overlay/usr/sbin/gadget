#!/bin/sh
# Eachine Sphere Link OTG gadget: the common NCM + ACM + Mass_Storage(DVR)
# gadget, plus board extras applied when the link comes up:
#   - the camera proxy (cam_proxy.sh), so pcpilot's menu and IDR requests
#     reach the camera HTTP/:12355/:11223 through the VRX;
#   - copy pcpilot's map packs for the goggles (map_sync.sh);
#   - start the RSSI forwarder that feeds the PC HUD (and the camera's
#     aalink) the real per-antenna link RSSI.
# PixelPilot keeps running and restreams the video to the PC (see
# restream: in pixelpilot.yaml). Credits to zhouruixi for the base.

# busybox here has no pkill: kill by command-line match
killf() {
	for p in $(ps w | grep -F -- "$1" | grep -v -e grep -e awk | awk '{print $1}'); do
		[ "$p" != "$$" ] && kill "$p" 2>/dev/null
	done
}

sed -i '/^ttyGS0/d' /etc/inittab
kill -HUP 1
if [ x$1 = "xinit" -a ! -f /tmp/gadget ] ; then
	exit 0
fi
rm -f /tmp/gadget

[ ! -e /sys/kernel/debug/usb/fcc00000.usb/mode ] && mount -t debugfs none /sys/kernel/debug
grep -q "/sys/kernel/config configfs" /proc/mounts || mount -t configfs none /sys/kernel/config

if [ "$(cat /sys/kernel/debug/usb/fcc00000.usb/mode)" = "host" ]; then
	echo device > /sys/kernel/debug/usb/fcc00000.usb/mode || exit 1
	sleep 0.5
fi

[ -d /sys/kernel/config/usb_gadget ] || modprobe libcomposite

if [ -d /sys/kernel/config/usb_gadget/g1 ]; then
	killf rssi_fwd.sh
	killf cam_proxy.sh
	killf map_sync.sh
	killf "bind=192.168.5.1"
	ifdown usb0
	cd /sys/kernel/config/usb_gadget/g1
	echo '' > UDC
	find . -type l -exec rm -v {} \;
	find configs -name 'strings' -exec rmdir -v {}/0x409 \;
	ls -d configs/* | xargs rmdir -v
	ls -d strings/* | xargs rmdir -v
	ls -d functions/* | xargs rmdir -v
	cd ..
	rmdir -v g1
	modprobe -r libcomposite > /dev/null 2>&1
	# no PC any more: the WFB video back to PixelPilot, the map back on
	/usr/bin/video_route.sh
	echo ">>> gadget torn down"
	exit 0
fi

HOST_MAC="48:6f:73:74:50:43"
DEVICE_MAC="42:61:64:55:53:42"
MASS_FILE=$(/usr/sbin/auto-dvr.sh | cut -d: -f 2)

echo ">>> creating gadget..."
cd /sys/kernel/config/usb_gadget/
mkdir g1
cd g1
echo "0x1d6b" > idVendor
echo "0x0104" > idProduct
echo "0x0100" > bcdDevice
echo "0x0200" > bcdUSB
echo "0xEF" > bDeviceClass
echo "0x02" > bDeviceSubClass
echo "0x01" > bDeviceProtocol

mkdir -p strings/0x409
cat /proc/device-tree/serial-number > strings/0x409/serialnumber
uname -r > strings/0x409/manufacturer
hostname -s > strings/0x409/product

mkdir -p configs/c.1/strings/0x409
echo "0x80" > configs/c.1/bmAttributes
echo 250 > configs/c.1/MaxPower
echo "config1: NCM + ACM + Mass_Storage" > configs/c.1/strings/0x409/configuration

mkdir -p functions/ncm.usb0
echo "$HOST_MAC" > functions/ncm.usb0/host_addr
echo "$DEVICE_MAC" > functions/ncm.usb0/dev_addr

mkdir -p functions/acm.gs0

mkdir -p functions/mass_storage.usb0
echo 1 > functions/mass_storage.usb0/stall
echo 1 > functions/mass_storage.usb0/lun.0/removable
echo "$MASS_FILE" > functions/mass_storage.usb0/lun.0/file

ln -s functions/ncm.usb0 configs/c.1/
ln -s functions/acm.gs0 configs/c.1/
ln -s functions/mass_storage.usb0 configs/c.1/

echo ">>> bind to $(ls /sys/class/udc)"
ls /sys/class/udc > UDC

echo 'ttyGS0::respawn:/sbin/agetty ttyGS0' >> /etc/inittab
kill -HUP 1

ifup usb0

# --- Eachine board extras: camera proxy for the PC + relay RSSI ---
# (This used to NAT the PC into the camera LAN with iptables, but the image
# ships no iptables: the rule failed silently and the PC's IDR requests and
# menu never reached the camera. The proxy needs nothing from the kernel.)
killf cam_proxy.sh
setsid /usr/bin/cam_proxy.sh >/dev/null 2>&1 &
killf rssi_fwd.sh
setsid /usr/bin/rssi_fwd.sh >/dev/null 2>&1 &
# map packs pcpilot fills from the web, copied for the goggles' map
killf map_sync.sh
setsid /usr/bin/map_sync.sh >/dev/null 2>&1 &
# in WFB the video goes straight to the PC now (video_route.sh)
/usr/bin/video_route.sh
echo ">>> gadget up (mass-storage + net + camera proxy + rssi relay)"
